{
	"name": "reading-status",
	"version": "1.0.0",
	"description": "Track reading status of your notes: visits, reading time, progress and chapters.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"reading-tracker"
	],
	"author": "Sugarcxne",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^5.0.2",
		"builtin-modules": "^5.4.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^5.0.2"
	}
}
